{
  "name": "sgecswtp-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "new": "node scripts/new-post.mjs",
    "new:post": "powershell -ExecutionPolicy Bypass -File scripts/new-post.ps1",
    "publish": "node scripts/publish.mjs",
    "publish:windows": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "obsidian:init": "node scripts/sync-obsidian-posts.mjs --direction site-to-obsidian",
    "obsidian:sync": "node scripts/sync-obsidian-posts.mjs --direction obsidian-to-site --prune",
    "obsidian:publish": "node scripts/sync-obsidian-posts.mjs --direction obsidian-to-site --prune --publish",
    "obsidian:watch": "node scripts/watch-obsidian-posts.mjs",
    "obsidian:auto-install": "node scripts/install-macos-autopublish.mjs",
    "obsidian:auto-remove": "node scripts/uninstall-macos-autopublish.mjs",
    "obsidian:auto-install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-obsidian-autopublish-task.ps1 -StartNow",
    "obsidian:auto-remove:windows": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-obsidian-autopublish-task.ps1"
  }
}
